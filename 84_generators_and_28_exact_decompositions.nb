 "Generator convention: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "1"], ",", "...", ",", 
    SubscriptBox["G", "12"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9f57e221-470d-439d-a5f3-080f64ccc820"],
 " are the 12 affine-line states, while ",
