Cell[CellGroupData[{

Cell[TextData[{
 "13. Exact reconstruction of every ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dc0e85f2-2ecf-4f95-8f5f-79f1426c8103"]
}], "Section",
 CellChangeTimes->{{4.000018746710685*^9, 
  4.000018748183173*^9}},ExpressionUUID->"3a88ff04-f801-4b10-99f9-\
526ce0edec68"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"reconstructedT", " ", "=", " ", 
   RowBox[{"Table", "[", " ", 
    RowBox[{
     RowBox[{"Sum", "[", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"weights", "[", 
         RowBox[{"[", 
          RowBox[{"r", ",", " ", "j"}], "]"}], "]"}], " ", "*", " ", 
        RowBox[{"G", "[", 
         RowBox[{"[", 
          RowBox[{"supports", "[", 
           RowBox[{"[", 
            RowBox[{"r", ",", " ", "j"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", 
         RowBox[{"Length", "[", 
          RowBox[{"supports", "[", 
           RowBox[{"[", "r", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "28"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"checks", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"reconstructedT", "[", 
       RowBox[{"[", "r", "]"}], "]"}], " ", "==", " ", 
      RowBox[{"T", "[", 
       RowBox[{"[", "r", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "1", ",", " ", "28"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", 
   "\"\<Exact checks for \!\(\*SubscriptBox[\(T\), \
\(1\)]\),...,\!\(\*SubscriptBox[\(T\), \(28\)]\):\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "checks", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<All 28 decompositions are exactly correct: \>\"", ",", " ", 
    RowBox[{"And", " ", "@@", " ", "checks"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.999142486104823*^9, 3.99914253689161*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"f4ed67a9-4af6-4d21-8573-ffa21f63b465"],

