Cell[CellGroupData[{

Cell["5. Inverse modulo 3", "Section",ExpressionUUID->"58d6a0c6-8f2d-4504-aad0-d31150739a79"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"invMod3", "[", "A_", "]"}], " ", ":=", " ", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"detMod3", "[", "A", "]"}], " ", "==", " ", "1"}], ",", " ", 
        "1", ",", " ", "2"}], "]"}], " ", "*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"A", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
          RowBox[{"-", 
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"A", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], "}"}]}], "}"}]}], 
     ",", "3"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.999141840543885*^9, 3.99914185900311*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"12f7eaf0-f53a-4865-9fa2-406cfe65d5ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Affine action on a 9-component coefficient vector", "Section",ExpressionUUID->"5437f668-c0d8-413f-8172-bb3c932a4758"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pointIndex", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"1", " ", "+", " ", 
    RowBox[{"3", " ", 
     RowBox[{"x", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
    RowBox[{"x", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"preimage", "[", 
    RowBox[{"A_", ",", " ", "t_", ",", " ", "x_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"invMod3", "[", "A", "]"}], " ", ".", " ", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"x", " ", "-", " ", "t"}], ",", " ", "3"}], "]"}]}], ",", 
     "3"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"affineAction", "[", 
    RowBox[{"v_", ",", " ", "A_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"[", 
       RowBox[{"pointIndex", "[", 
        RowBox[{"preimage", "[", 
         RowBox[{"A", ",", " ", "t", ",", " ", "x"}], "]"}], "]"}], "]"}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "phasePoints"}], "}"}]}], " ", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.999141956022414*^9, 3.999141981195169*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"4a60b5f8-f44f-475a-b749-832ee54cd5fc"]
}, Open  ]],

