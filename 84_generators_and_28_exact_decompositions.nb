Cell[CellGroupData[{

Cell["4. Construct GL(2,3)", "Section",ExpressionUUID->"fd5824c3-48e7-4346-b36c-cce855509062"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"detMod3", "[", "A_", "]"}], " ", ":=", " ", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", 
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", 
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}]}], ",", "3"}], " ", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fourTuples", " ", "=", " ", 
   RowBox[{"Tuples", "[", 
    RowBox[{"f3", ",", " ", "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allMatrices", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{"fourTuples", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", " ", "2"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", 
       RowBox[{"Length", "[", "fourTuples", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"GL23", " ", "=", " ", 
   RowBox[{"Select", "[", " ", 
    RowBox[{"allMatrices", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"detMod3", "[", "#", "]"}], " ", "!=", " ", "0"}], " ", 
      "&"}]}], " ", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Number of matrices in GL(2,3) = \>\"", ",", " ", 
    RowBox[{"Length", "[", "GL23", "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.999141641535616*^9, 3.999141665520729*^9}, {
  3.999141732606572*^9, 3.9991417438101*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"d202c533-a5e2-4579-8de8-960cdec01ddb"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Number of matrices in GL(2,3) = \"\>", "\[InvisibleSpace]", 
