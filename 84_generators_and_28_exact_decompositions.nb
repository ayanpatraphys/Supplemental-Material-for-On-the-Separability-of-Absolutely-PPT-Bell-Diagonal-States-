  FormBox[
   RowBox[{
    SubscriptBox["G", "13"], ",", "...", ",", 
    SubscriptBox["G", "84"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f77bb2f6-f1c6-498c-bd86-7e5376d8ade5"],
 " are the 72 distinct affine images of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5172c880-13fb-48c5-ae54-a637e2190dc5"],
 ". Coefficient vectors use the flattening order (00,01,02,10,11,12,20,21,22)."
}], "Text",
 CellChangeTimes->{{3.999141349327289*^9, 
  3.999141393063682*^9}},ExpressionUUID->"7ab61769-db68-4cf5-9c84-\
a1db004417f0"],

