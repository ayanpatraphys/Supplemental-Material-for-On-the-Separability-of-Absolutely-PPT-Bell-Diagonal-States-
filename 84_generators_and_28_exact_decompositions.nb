Cell[CellGroupData[{
Cell["\<\
84 separable generators and exact decompositions of the 28 representatives\
\>", "Title",ExpressionUUID->"603db72b-d646-486c-936f-3dfe7bad4631"],

Cell[TextData[{
 "This notebook is completely self-contained. It constructs all 84 generators \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d3ce1b7d-52bf-4bed-85ac-63888483afb3"],
 ", stores the 28 representatives ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f9c869fa-8430-47ca-8bf9-7be94ead6a32"],
 " in the manuscript order, lists every support ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4702126d-06f7-4591-97aa-486f5552f7b5"],
 " and its exact rational weights, and verifies all 28 decompositions exactly."
}], "Text",
 CellChangeTimes->{{3.99914132492799*^9, 
  3.9991413463882303`*^9}},ExpressionUUID->"a19ebd8c-e93f-4652-8421-\
fbc4ffd2a380"],

