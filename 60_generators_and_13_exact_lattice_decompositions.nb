Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"a", "[", "z_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"5", " ", "-", " ", "z"}], ")"}], "/", 
