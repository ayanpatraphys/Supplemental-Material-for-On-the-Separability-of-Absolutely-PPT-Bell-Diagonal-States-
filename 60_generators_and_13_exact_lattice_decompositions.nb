Cell[CellGroupData[{

Cell[TextData[{
 "5. Construct the 60 separable generator vectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "j"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5f8d7563-4f08-4f42-9acb-aa073d781d79"]
}], "Section",
 CellChangeTimes->{{4.0001128100283337`*^9, 
  4.000112811167481*^9}},ExpressionUUID->"e2c86508-e3ed-4c95-9b27-\
0654206f2f9e"],

Cell[TextData[{
 "For an affine plane L, its generator vector has coefficient 1/4 at each \
label in L and zero elsewhere. Thus ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "j"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67e194e2-c38a-4d88-80cb-4c588919895f"],
 " is the coefficient vector of the separable state ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    SubscriptBox["L", "j"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d1de296-eb6b-4d63-ba19-19936cbab901"],
 ", where j is its decimal generator label in {1,...,60}. Every  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "j"], TraditionalForm]],ExpressionUUID->
  "9ae7990a-dbea-4b86-ad79-30402193a521"],
 " is displayed in the fixed binary flattening order 0000,0001,...,1111."
}], "Text",
 CellChangeTimes->{{4.000112121828938*^9, 
  4.0001121481681433`*^9}},ExpressionUUID->"14ecfd63-d54b-444f-aaa4-\
d3b02c39ea0a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"planeVector", "[", "L_", "]"}], ":=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"L", ",", " ", 
          RowBox[{"integerToLabel", "[", "k", "]"}]}], "]"}], ",", " ", 
        RowBox[{"1", "/", "4"}], ",", " ", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "0", ",", " ", "15"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"G", " ", "=", " ", 
   RowBox[{"planeVector", " ", "/@", " ", "affinePlanes"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"incidenceMatrix", " ", "=", " ", 
    RowBox[{"Transpose", "[", "G", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Number of generators = \>\"", ",", " ", 
    RowBox[{"Length", "[", "G", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", " ", 
    RowBox[{"\"\<All generators are normalized and nonnegative = \>\"", ",", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", "#", "]"}], " ", "==", " ", "1"}], " ", "&&",
            " ", 
           RowBox[{"And", " ", "@@", " ", 
            RowBox[{"Thread", "[", 
             RowBox[{"#", " ", ">=", " ", "0"}], "]"}]}]}], ")"}], " ", "&"}],
         " ", "/@", " ", "G"}], ")"}]}]}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"generatorTable", " ", "=", " ", 
    RowBox[{"Grid", "[", " ", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"j", ",", " ", 
            RowBox[{"planeCodes", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
            RowBox[{"G", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", 
            RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\"\<decimal generator label j\>\"", ",", " ", 
          "\"\<internal plane code for \!\(\*SubscriptBox[\(L\), \
\(j\)]\)\>\"", ",", " ", 
          "\"\<flattened \!\(\*SubscriptBox[\(G\), \(j\)]\) (0000,...,1111)\>\
\""}], "}"}]}], "]"}], ",", 
      RowBox[{"Frame", " ", "->", " ", "All"}], ",", "\n", "  ", 
      RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", "generatorTable"}], "Input",
 CellChangeTimes->{{4.000112151560135*^9, 4.000112232408618*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"04858cb9-43b6-4bb6-b1ed-83779f629000"],

