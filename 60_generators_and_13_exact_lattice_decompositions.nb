Cell[TextData[{
 "6. Construct the 13 flattened orbit representatives ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e59d3f77-28f6-4971-bf85-3a6f8064a44f"]
}], "Section",
 CellChangeTimes->{{4.000112817106743*^9, 
  4.00011281788873*^9}},ExpressionUUID->"0e72fdef-0398-4de5-9481-\
e1b0da9a7f7e"],

Cell[TextData[{
 "For z \[LessEqual] 3, the representative has the distinguished coefficient ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "z"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b1fbec2f-913b-47e6-abac-b8484977ae05"],
 " at d, zero on Z, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "z"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a7a32830-fc1c-43f1-9dc4-a1a9135a1943"],
 " elsewhere. For z=4, it is zero on Z and 1/12 elsewhere. The data are \
entered in the same orbit order as in the manuscript."
}], "Text",
 CellChangeTimes->{{4.000112263841186*^9, 
  4.000112283176302*^9}},ExpressionUUID->"ef21ea8e-da05-4bdf-8837-\
f27099f7c131"],

