Cell[CellGroupData[{

Cell["2. Symplectic product", "Section",ExpressionUUID->"5c787fec-b598-43b4-ab69-a701ebb8da49"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["p", "1"], ",", 
      SubscriptBox["q", "1"], ",", 
      SubscriptBox["p", "2"], ",", 
      SubscriptBox["q", "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f20445d8-5629-4e3e-b5d1-21c73a904e46"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["p", "1"], "'"}], ",", 
      RowBox[{
       SubscriptBox["q", "1"], "'"}], ",", 
      RowBox[{
       SubscriptBox["p", "2"], "'"}], ",", 
      RowBox[{
       SubscriptBox["q", "2"], "'"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "95ca0c9e-6285-4c0b-b7ca-afa95f83be2f"],
 "), the binary symplectic product is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "1"], TraditionalForm]],ExpressionUUID->
  "d315fc8b-cef3-42ea-b762-165caa8a86f3"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "1"], "'"}], TraditionalForm]],ExpressionUUID->
  "2af59624-9dc8-4fd4-8d42-f60ad65f9120"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["q", "1"]}], TraditionalForm]],ExpressionUUID->
  "7526fcfb-5dd1-4734-a598-13a5835b34da"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "1"], "'"}], TraditionalForm]],ExpressionUUID->
  "47a35415-1a7a-470c-b331-a038cc20d0bc"],
 " +  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "2"], TraditionalForm]],ExpressionUUID->
  "d5710eec-11af-4af6-accf-35e75649c01c"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "2"], "'"}], TraditionalForm]],ExpressionUUID->
  "1fe38104-f920-4dfd-a4e4-93d544e46a0d"],
 " +  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "2"], TraditionalForm]],ExpressionUUID->
  "1666612e-5f86-4c6b-a2e1-3e58e4a64c38"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "2"], "'"}], TraditionalForm]],ExpressionUUID->
  "54780c89-081b-4b28-9ab5-d2b6ac5a1fd9"],
 "  modulo 2."
}], "Text",
 CellChangeTimes->{{4.0001114969753523`*^9, 
  4.000111623142723*^9}},ExpressionUUID->"f79dd7c6-c004-4b69-b9c4-\
09a5c2435840"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bitPlus", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], ":=", " ", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"x", " ", "+", " ", "y"}], ",", " ", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"symp", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], ":=", " ", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", 
       RowBox[{"y", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", 
       RowBox[{"y", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", "  ", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", 
       RowBox[{"y", "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"[", "4", "]"}], "]"}], " ", 
       RowBox[{"y", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}]}], ",", " ", "2"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"isIsotropic", "[", "H_", "]"}], ":=", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"symp", "[", 
         RowBox[{"x", ",", " ", "y"}], "]"}], " ", "==", " ", "0"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "H"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"y", ",", " ", "H"}], "}"}]}], "]"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.000111627929171*^9, 4.000111699394557*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"e4ae65d0-b8a5-41cd-ad6a-58bc1080279f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Construct the 15 Lagrangian subspaces", "Section",ExpressionUUID->"6329c621-c04e-4651-9004-09d4ad182428"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nonzeroLabels", " ", "=", " ", 
   RowBox[{"Rest", "[", "labels", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"commutingPairs", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{"nonzeroLabels", ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"symp", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "==", " ", "0"}], " ",
       "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lagrangianSubspaces", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", " ", 
    RowBox[{"Sort", " ", "/@", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"zero", ",", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
          RowBox[{"bitPlus", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], " ", "&"}], 
       " ", "/@", "commutingPairs"}], ")"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lagrangianSubspaces", " ", "=", " ", 
   RowBox[{"SortBy", "[", 
    RowBox[{"lagrangianSubspaces", ",", 
     RowBox[{
      RowBox[{"labelToInteger", " ", "/@", " ", "#"}], " ", "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lagrangianHex", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"hexDigit", " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{"labelToInteger", " ", "/@", " ", "#"}], ")"}]}], " ", "&"}],
       ")"}], " ", "/@", " ", "lagrangianSubspaces"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Number of Lagrangian subspaces = \>\"", ",", 
    RowBox[{"Length", "[", "lagrangianSubspaces", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Each has four elements = \>\"", ",", " ", 
    RowBox[{"And", " ", "@@", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "#", "]"}], " ", "==", " ", "4"}], " ", "&"}],
        " ", "/@", " ", "lagrangianSubspaces"}], ")"}]}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<All are isotropic = \>\"", ",", 
     RowBox[{"And", " ", "@@", " ", 
      RowBox[{"(", 
       RowBox[{"isIsotropic", " ", "/@", " ", "lagrangianSubspaces"}], 
       ")"}]}]}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"lagrangianHex", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"Length", "[", "lagrangianHex", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<subspace\>\"", ",", " ", "\"\<hexadecimal labels\>\""}], 
      "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.00011170507164*^9, 4.000111814677474*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"438cf339-4f9a-42e7-b77f-c5a8bf3c6b6c"],

