Cell["10. Exact reconstruction of every representative", "Section",ExpressionUUID->"2df4bb2e-3cbd-437e-b767-bcf5f1b59ccd"],

Cell[TextData[{
 "The full 60-component vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72fd0b9d-d16d-4c55-8522-0c0f65753c89"],
 " is obtained by placing the computed positive weights at the decimal \
positions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f6a60864-929a-420b-a231-4f5ea7bd5184"],
 " and zeros elsewhere. Multiplication by the 16 by 60 incidence matrix \
reconstructs the representative exactly in the binary flattening order \
0000,0001,...,1111."
}], "Text",
 CellChangeTimes->{{4.000112774373899*^9, 4.000112775361412*^9}, {
  4.0001129931497517`*^9, 
  4.000112994002408*^9}},ExpressionUUID->"020fec91-8bb0-4ec2-b8a3-\
678b8d5ada24"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fullWeightVectors", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ReplacePart", "[", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", "60"}], "]"}], ",", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"supports", "[", 
           RowBox[{"[", "r", "]"}], "]"}], " ", "->", " ", 
          RowBox[{"weights", "[", 
           RowBox[{"[", "r", "]"}], "]"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", 
        RowBox[{"Length", "[", "V", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"reconstructed", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"incidenceMatrix", ".", "#"}], " ", "&"}], " ", "/@", " ", 
    "fullWeightVectors"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"individualChecks", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"reconstructed", "[", 
        RowBox[{"[", "r", "]"}], "]"}], " ", "===", " ", 
       RowBox[{"V", "[", 
        RowBox[{"[", "r", "]"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", 
        RowBox[{"Length", "[", "V", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"verificationTable", " ", "=", " ", 
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"r", ",", 
            RowBox[{"individualChecks", "[", 
             RowBox[{"[", "r", "]"}], "]"}], ",", 
            RowBox[{"Total", "[", 
             RowBox[{"fullWeightVectors", "[", 
              RowBox[{"[", "r", "]"}], "]"}], "]"}], ",", 
            RowBox[{"Count", "[", 
             RowBox[{
              RowBox[{"fullWeightVectors", "[", 
               RowBox[{"[", "r", "]"}], "]"}], ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", " ", ">", " ", "0"}]}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", 
            RowBox[{"Length", "[", "V", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\"\<r\>\"", ",", " ", "\"\<exact reconstruction\>\"", ",", " ", 
          "\"\<sum of weights\>\"", ",", " ", "\"\<support size\>\""}], 
         "}"}]}], "]"}], ",", 
      RowBox[{"Frame", " ", "->", " ", "All"}], ",", 
      RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"verificationTable", "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<All 13 decompositions verified exactly = \>\"", ",", " ", 
    RowBox[{"And", " ", "@@", " ", "individualChecks"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.000112767571021*^9, 4.000112771896913*^9}, {
  4.000113006226268*^9, 4.000113134231086*^9}},
 CellLabel->
  "In[104]:=",ExpressionUUID->"9a1c8647-63c9-44d7-963e-c8413c3f7d5c"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"r\"\>", "\<\"exact reconstruction\"\>", "\<\"sum of weights\"\>", "\
\<\"support size\"\>"},
    {"1", "True", "1", "5"},
    {"2", "True", "1", "10"},
    {"3", "True", "1", "7"},
    {"4", "True", "1", "7"},
    {"5", "True", "1", "7"},
    {"6", "True", "1", "7"},
    {"7", "True", "1", "7"},
    {"8", "True", "1", "6"},
    {"9", "True", "1", "7"},
    {"10", "True", "1", "6"},
    {"11", "True", "1", "6"},
    {"12", "True", "1", "6"},
    {"13", "True", "1", "6"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.0001131440429163`*^9},
 CellLabel->
  "Out[108]=",ExpressionUUID->"9de6b4cb-bc94-4fdb-9b19-a82a6eab4519"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"All 13 decompositions verified exactly = \"\>", 
   "\[InvisibleSpace]", "True"}],
  SequenceForm["All 13 decompositions verified exactly = ", True],
  Editable->False]], "Print",
 CellChangeTimes->{4.000113144044922*^9},
 CellLabel->
  "During evaluation of \
In[104]:=",ExpressionUUID->"17dd2fe2-0d36-4a21-9899-555377a38832"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Direct coefficient-by-coefficient incidence check", "Section",ExpressionUUID->"5846864a-a47c-4c3b-83b2-2e5ce3f33eb3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"incidenceValue", "[", 
     RowBox[{"r_", ",", " ", "x_"}], "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "4"}], ")"}], " ", 
     RowBox[{"Total", "[", 
      RowBox[{"Pick", "[", 
       RowBox[{
        RowBox[{"weights", "[", 
         RowBox[{"[", "r", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{
            RowBox[{"affinePlanes", "[", 
             RowBox[{"[", "#", "]"}], "]"}], ",", 
            RowBox[{"integerToLabel", "[", "x", "]"}]}], "]"}], "&"}], "/@", 
         RowBox[{"supports", "[", 
          RowBox[{"[", "r", "]"}], "]"}]}]}], "]"}], "]"}]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"incidenceCheck", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"incidenceValue", "[", 
          RowBox[{"r", ",", " ", "x"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "0", ",", " ", "15"}], "}"}]}], "]"}], " ", "===",
        " ", 
       RowBox[{"V", "[", 
        RowBox[{"[", "r", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", " ", 
        RowBox[{"Length", "[", "V", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<All coefficientwise incidence checks passed = \>\"", ",", 
    RowBox[{"And", " ", "@@", " ", "incidenceCheck"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.00011316045267*^9, 4.000113259410448*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"563d6889-799b-442e-8715-bb77ac4f2971"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"All coefficientwise incidence checks passed = \"\>", 
   "\[InvisibleSpace]", "True"}],
  SequenceForm["All coefficientwise incidence checks passed = ", True],
  Editable->False]], "Print",
 CellChangeTimes->{4.0001132653259573`*^9},
 CellLabel->
  "During evaluation of \
In[110]:=",ExpressionUUID->"e4f97574-1866-429a-8572-f09572506b7b"]
}, Open  ]]
}, Open  ]]
