Cell[CellGroupData[{

Cell["4. Construct and order the 60 affine Lagrangian planes", "Section",ExpressionUUID->"a14330fd-d8a6-482c-b7db-cc3cd3ae220e"],

Cell[TextData[{
 "After lexicographically ordering the 60 affine planes, we denote them by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "1"], ",", 
    SubscriptBox["L", "2"], ",", "...", ",", 
    SubscriptBox["L", "60"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e5c033f-bc44-476a-ba35-61f5b4f2564c"],
 " and label the associated generators by the decimal indices 1,2,...,60. \
These are the labels used in every support ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b99fe4e-8178-4319-9a54-850107fa906c"],
 " below."
}], "Text",
 CellChangeTimes->{{4.000111861471259*^9, 
  4.000111882824381*^9}},ExpressionUUID->"068b4b79-1a36-473a-95fb-\
3604481cb40f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"affinePlanes", " ", "=", " ", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"Sort", " ", "/@", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"bitPlus", "[", 
             RowBox[{"t", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
           "H"}], ",", 
          RowBox[{"{", 
           RowBox[{"H", ",", " ", "lagrangianSubspaces"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "labels"}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"affinePlanes", " ", "=", " ", 
    RowBox[{"SortBy", "[", 
     RowBox[{"affinePlanes", ",", 
      RowBox[{
       RowBox[{"labelToInteger", " ", "/@", " ", "#"}], " ", "&"}]}], "]"}]}],
    ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"planeCodes", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"StringJoin", "[", 
        RowBox[{"hexDigit", " ", "/@", " ", 
         RowBox[{"(", 
          RowBox[{"labelToInteger", " ", "/@", " ", "#"}], ")"}]}], "]"}], 
       " ", "&"}], ")"}], " ", "/@", " ", "affinePlanes"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
