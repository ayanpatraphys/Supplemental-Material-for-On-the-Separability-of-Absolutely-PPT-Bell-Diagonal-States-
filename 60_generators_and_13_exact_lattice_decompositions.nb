Cell[CellGroupData[{

Cell[TextData[{
 "8. Compute the exact rational weights ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "rj"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ecbbd7f9-8971-4d3e-9113-7f3a9f222d0b"]
}], "Section",
 CellChangeTimes->{{4.0001128295602016`*^9, 
  4.000112830834846*^9}},ExpressionUUID->"c131526c-ddfe-4d6e-9d67-\
5279128ae998"],

Cell[TextData[{
 "For each selected support, ",
 StyleBox["Solve",
  FontColor->RGBColor[0, 0, 1]],
 " determines the unique exact weights from the coefficient identity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Transpose",
      FontColor->RGBColor[0, 0, 1]], "[", 
     RowBox[{"G", "[", 
      RowBox[{"[", 
       SubscriptBox["S", "r"], "]"}], "]"}], "]"}], ".", 
    SubscriptBox["q", "r"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a32c0dc4-fb5f-4a2a-8c2b-e23662df386a"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b868c37d-5796-4722-a355-e0055fb3c457"],
 " together with normalization. No floating-point arithmetic is used."
}], "Text",
 CellChangeTimes->{{4.000112837705022*^9, 
  4.000112876429003*^9}},ExpressionUUID->"26214fd4-2ed8-4fbc-88ad-\
7e284c105295"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"computeWeights", "[", "r_", "]"}], ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "s", ",", " ", "vars", ",", " ", "equations", ",", " ", "solutions", 
        ",", " ", "answer"}], "}"}], ",", 
      RowBox[{
       RowBox[{"s", " ", "=", " ", 
        RowBox[{"supports", "[", 
         RowBox[{"[", "r", "]"}], "]"}]}], ";", 
       RowBox[{"vars", " ", "=", " ", 
        RowBox[{"Array", "[", 
         RowBox[{"q", ",", " ", 
          RowBox[{"Length", "[", "s", "]"}]}], "]"}]}], ";", 
       RowBox[{"equations", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"G", "[", 
               RowBox[{"[", "s", "]"}], "]"}], "]"}], ".", "vars"}], " ", "==",
             " ", 
            RowBox[{"V", "[", 
             RowBox[{"[", "r", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Total", "[", "vars", "]"}], " ", "==", " ", "1"}], 
           "}"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"solutions", " ", "=", " ", 
        RowBox[{"Solve", "[", 
         RowBox[{"equations", ",", " ", "vars"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"solutions", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", "$Failed", ",", 
         RowBox[{
          RowBox[{"answer", " ", "=", " ", 
           RowBox[{"vars", " ", "/.", " ", 
            RowBox[{"First", "[", "solutions", "]"}]}]}], ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"And", " ", "@@", " ", 
             RowBox[{"Thread", "[", 
              RowBox[{"answer", " ", ">", " ", "0"}], "]"}]}], ",", "answer", 
            ",", "$Failed"}], "]"}]}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"weights", " ", "=", " ", 
    RowBox[{"computeWeights", " ", "/@", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "V", "]"}], "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"expectedWeights", " ", "=", " ", 
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"1", "/", "5"}], ",", " ", "5"}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "18"}], ",", " ", 
        RowBox[{"1", "/", "6"}], ",", " ", 
        RowBox[{"1", "/", "6"}], ",", " ", 
        RowBox[{"1", "/", "18"}], ",", " ", 
        RowBox[{"1", "/", "6"}], ",", " ", 
        RowBox[{"1", "/", "18"}], ",", " ", 
