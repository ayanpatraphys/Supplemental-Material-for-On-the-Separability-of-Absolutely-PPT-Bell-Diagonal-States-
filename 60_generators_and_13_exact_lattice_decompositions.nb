        RowBox[{"1", "/", "18"}], ",", " ", 
        RowBox[{"1", "/", "18"}], ",", " ", 
        RowBox[{"1", "/", "18"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "8"}], ",", " ", 
        RowBox[{"1", "/", "8"}], ",", " ", 
        RowBox[{"1", "/", "8"}], ",", " ", 
        RowBox[{"1", "/", "4"}], ",", " ", 
        RowBox[{"1", "/", "8"}], ",", " ", 
        RowBox[{"1", "/", "8"}], ",", " ", 
        RowBox[{"1", "/", "8"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "8"}], ",", " ", 
        RowBox[{"1", "/", "8"}], ",", " ", 
        RowBox[{"1", "/", "4"}], ",", " ", 
        RowBox[{"1", "/", "8"}], ",", " ", 
        RowBox[{"1", "/", "8"}], ",", " ", 
        RowBox[{"1", "/", "8"}], ",", " ", 
        RowBox[{"1", "/", "8"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"1", "/", "7"}], ",", " ", "7"}], "]"}], ",", "\n", "  ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"1", "/", "7"}], ",", " ", "7"}], "]"}], ",", "\n", "  ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"1", "/", "7"}], ",", " ", "7"}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "/", "7"}], ",", " ", 
        RowBox[{"1", "/", "7"}], ",", " ", 
        RowBox[{"1", "/", "7"}], ",", " ", 
        RowBox[{"1", "/", "7"}], ",", " ", 
        RowBox[{"1", "/", "7"}], ",", " ", 
        RowBox[{"1", "/", "7"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"1", "/", "7"}], ",", " ", "7"}], "]"}], ",", "\n", "  ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"1", "/", "6"}], ",", " ", "6"}], "]"}], ",", "\n", "  ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"1", "/", "6"}], ",", " ", "6"}], "]"}], ",", "\n", "  ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"1", "/", "6"}], ",", " ", "6"}], "]"}], ",", "\n", "  ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"1", "/", "6"}], ",", " ", "6"}], "]"}]}], "\n", "}"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<All exact weights were found = \>\"", ",", " ", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"weights", ",", " ", "$Failed"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<All support weights are strictly positive = \>\"", ",", " ", 
    RowBox[{"And", " ", "@@", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"#", " ", ">", " ", "0"}], "]"}], " ", "&"}], ")"}], " ", "/@",
        " ", "weights"}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Every weight list sums to one = \>\"", ",", " ", 
    RowBox[{"And", " ", "@@", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", "#", "]"}], " ", "==", " ", "1"}], " ", "&"}], 
       " ", "/@", " ", "weights"}], ")"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Computed weights match the manuscript certificates = \>\"", ",", " ", 
    
    RowBox[{"weights", " ", "===", " ", "expectedWeights"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.000112534773528*^9, 4.000112658782467*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"52e512c8-cfb8-409a-81d8-94d151c2b929"],

